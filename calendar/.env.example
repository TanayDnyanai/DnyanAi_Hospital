# Copy to .env and adjust as needed.

# Where the receptionist project (and its clinic.db) lives.
# RECEPTIONIST_DIR=../medical-receptionist
# CLINIC_DB_PATH=../medical-receptionist/clinic.db

# Storage backend: legacy | production | neon
DATA_SOURCE=legacy

# Neon (only when DATA_SOURCE=neon). Use the pooled URL for app traffic and
# the direct/unpooled URL for schema migrations. Never commit real values.
# DATABASE_URL=postgresql://...@...-pooler.../neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://...@.../neondb?sslmode=require

# Clinic scheduling
CLINIC_SLOT_MINUTES=30
CLINIC_TIMEZONE_OFFSET_MINUTES=330

# Feature flags
ALLOW_PATIENT_BOOKING=false
ALLOW_DOCTOR_STATUS_UPDATES=true

# Server
APP_HOST=127.0.0.1
APP_PORT=8100
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8100,http://127.0.0.1:8100

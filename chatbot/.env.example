# Copy to .env and fill values

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Database / memory backend
# legacy = local clinic.db; neon = shared Neon Postgres
DATA_SOURCE=legacy
MEMORY_BACKEND=legacy
# DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
# Required for MEMORY_BACKEND=neon. Exactly 16, 24 or 32 ASCII characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
# LANGGRAPH_AES_KEY=

# Notifications / WhatsApp
TIMEZONE=Asia/Kolkata
PORTAL_BASE_URL=http://localhost:8000
# link = generate wa.me click-to-chat links (no API fees, staff/manual)
# api  = automated WhatsApp Business API (provider required, fees may apply)
WHATSAPP_MODE=link

# Twilio WhatsApp configuration
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=whatsapp:+17372508034
# TWILIO_CONTENT_SID=   # Optional pre-approved Content Template SID (HX...) for outbound messages outside 24h window

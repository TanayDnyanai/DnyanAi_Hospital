# Copy to .env.local in this directory, or set these as real environment
# variables when deploying. Never commit filled-in values.

DATA_SOURCE=neon

# Neon Postgres: pooled URL for app traffic, direct URL for DDL/migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Chatbot model
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# LangGraph persistence. Checkpoints are encrypted with this key.
MEMORY_BACKEND=neon
LANGGRAPH_AES_KEY=

# Optional: trace/debug (leave unset in production)
LANGCHAIN_TRACING_V2=false

# WhatsApp notifications
WHATSAPP_MODE=link
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PORTAL_BASE_URL=http://127.0.0.1:8000
TIMEZONE=Asia/Kolkata

# Optional legacy/test-only paths
# CLINIC_DB_PATH=../chatbot/clinic.db
